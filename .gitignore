# Giperion/.gitignore                                             v002
# Что не должно попадать в репозиторий при инициализации git.

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/

# --- Веса моделей (восстанавливаются обучением) ---
models/*.pt

# --- Рабочие журналы и скриншоты ---
logs/

# --- Личные архивы памяти ---
archive/

# --- Пользовательские и изменяемые данные ---
data/conversations.json
data/conversations_before_model_tags.json
data/unknown_messages.json
data/unknown_labels.json
data/user_profile.json
data/model_stats.json
data/model_settings.json
data/conference_settings.json
data/custom_models.json
data/window_settings.json
data/personality_settings.json
data/dataset/
data/chat_contexts/

# --- Обновления: скачанные патчи, резервные копии и установленная версия ---
updates/
data/update_state.json

# --- Резервные копии агента перед правкой файлов ---
data/agent_backups/

# --- Журнал прогонов агента ---
data/agent_runs.jsonl

# --- Отчёты стенда оценки агента ---
data/agent_eval/

# --- Состояния задач агента ---
data/agent_tasks/

# --- Настройки провайдера агента (ключ) ---
data/agent_settings.json

# --- Индекс проекта для поиска символов ---
data/agent_index.json

# --- Настройки MCP-серверов ---
data/agent_mcp.json

# --- Настройки наблюдателя за файлами ---
data/agent_watch.json

# --- Python для песочницы плагинов и её временная папка ---
data/plugin_python/
.agent_plugin_tmp/

# --- Папки, куда плагинам разрешено писать в контейнере ---
data/agent_plugin_out/

# --- Параллельные рабочие деревья агента ---
.agent_worktrees/

# --- Временные файлы атомарной записи ---
*.tmp
.intents_*.tmp
.*.tmp

# --- Python-окружение для MCP-серверов ---
data/mcp_venv/
data/agent_semantic.json
data/agent_vectors.json
data/agent_browser/
data/agent_memory.md
data/agent_vectors.db
data/agent_vectors.db-wal
data/agent_vectors.db-shm
%SystemDrive%/
data/agent_audit.jsonl
dist/
data/agent_schedule.json
data/agent_schedule_runs.jsonl
